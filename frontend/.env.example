# Copy to frontend/.env.local. Never commit a real key.
# Browser key with Maps JavaScript API enabled (needed for single player).
VITE_GOOGLE_MAPS_API_KEY=

# Optional override for capital name mode. JavaScript Vector Map ID with Country layer.
VITE_GOOGLE_MAPS_BOUNDARY_MAP_ID=8a4f58eaf6594d8cc0cd3856

# OAuth client ID for "Sign in with Google" (optional; see the README). Same value as the backend's.
VITE_GOOGLE_CLIENT_ID=
